generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")   // pooled — app runtime
  directUrl = env("DIRECT_URL")     // direct — migrations only
}

// NOTE: All future app data (Statement, Job, Transaction, Answer, ...) will carry a
// `userId` FK to User with `onDelete: Cascade`. A user must be able to delete their
// account and ALL derived financial data in one atomic, DB-enforced action (privacy /
// right-to-erasure). Account and Session below already model that cascade.
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  statements    Statement[]
  createdAt     DateTime  @default(now())   // audit: when the account was created
  updatedAt     DateTime  @updatedAt        // audit: last profile change
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

enum StatementStatus {
  UPLOADED
  PROCESSING // included now for M3 readiness; sync flow won't set it yet
  PROCESSED
  FAILED
}

model Statement {
  id           String          @id @default(cuid())
  userId       String
  fileName     String // original upload name, for display
  contentHash  String // hash of file bytes, for idempotency
  status       StatementStatus @default(UPLOADED)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  job          Job?

  @@unique([userId, contentHash]) // idempotency: same file + same user => no duplicate
  @@index([userId])
}

model Transaction {
  id             String    @id @default(cuid())
  statementId    String
  date           DateTime
  rawDescription String
  amount         Decimal   @db.Decimal(14, 2) // money as EXACT decimal — never Float
  currency       String    @default("USD")
  createdAt      DateTime  @default(now())
  statement      Statement @relation(fields: [statementId], references: [id], onDelete: Cascade)

  @@index([statementId])
}

// State ownership: Statement.status is the UI-facing lifecycle and the source of truth for
// "is it done" (stays in Postgres, NOT Redis, so there's no state drift). Job holds the
// processing METADATA — attempts, current stage, last error, timing — for observability and
// retries. The worker (3C) updates BOTH atomically. Redis is used only for idempotency keys
// and rate limiting, never as the status store.
enum JobState {
  QUEUED
  PROCESSING
  DONE
  FAILED
}

model Job {
  id          String    @id @default(cuid())
  statementId String    @unique // 1:1 with Statement
  state       JobState  @default(QUEUED)
  stage       String? // e.g. "extract" | "parse" | "persist" — for observability
  error       String? // last failure reason (no PII)
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  statement   Statement @relation(fields: [statementId], references: [id], onDelete: Cascade)
}
