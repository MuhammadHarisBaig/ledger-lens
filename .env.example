# LedgerLens environment variables — NAMES ONLY, no real values.
# Copy to `.env.local` and fill in for local development. Never commit real secrets.

# Database — Neon Postgres connection string (used by Prisma)
DATABASE_URL=

# Database — Neon DIRECT (non-pooled) connection, used by Prisma migrations only
DIRECT_URL=

# Auth.js — secret used to encrypt sessions/JWT (generate: npx auth secret)
AUTH_SECRET=

# Google OAuth 2.0 client credentials (Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Gemini API key (Google AI Studio)
GEMINI_API_KEY=

# Upstash QStash — token to publish jobs to the queue
QSTASH_TOKEN=
# Optional — base URL of the QStash LOCAL dev server (npx @upstash/qstash-cli dev) for local e2e
QSTASH_URL=

# Upstash QStash — signing keys to verify inbound requests at the worker endpoint
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Upstash Redis (REST) — job status, idempotency keys, rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel Blob — read/write token for storing raw uploaded PDFs
BLOB_READ_WRITE_TOKEN=
